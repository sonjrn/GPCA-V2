# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments. Anchored to the repository root: an unanchored `env/`
# would also exclude infra/env/, and a file inside an excluded directory cannot
# be re-included by a later negation.
.venv/
venv/
/env/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/

# --- Node / frontend --------------------------------------------------------
node_modules/
.vite/
ui/dist/

# --- Secrets ----------------------------------------------------------------
# infra/env/.env.example is the tracked template; real values never are.
.env
.env.*
!.env.example
!infra/env/.env.example

# --- Editors / OS -----------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
