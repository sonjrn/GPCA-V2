# Copy to .env and fill in. Never commit a populated .env -- it is gitignored.
# Every variable the application reads is listed here; config.py (#5) validates
# them at boot, so a missing value fails startup rather than the first request.

# --- Core -------------------------------------------------------------------
FLASK_ENV=development
SECRET_KEY=change-me-in-every-environment
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173

# --- Database ---------------------------------------------------------------
# Alembic reads DATABASE_URL directly, so migrations run unchanged everywhere.
DATABASE_URL=postgresql+psycopg://gpca:gpca@db:5432/gpca
POSTGRES_USER=gpca
POSTGRES_PASSWORD=gpca
POSTGRES_DB=gpca

# --- Redis (sessions, rate limits, job queue) -------------------------------
REDIS_URL=redis://redis:6379/0

# --- Auth -------------------------------------------------------------------
JWT_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# --- Object storage (MinIO in dev, S3 in prod) ------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET_MEDIA=gpca-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/gpca-media

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
CHECKOUT_SUCCESS_URL=http://localhost:5173/checkout/success
CHECKOUT_CANCEL_URL=http://localhost:5173/cart

# --- Email (AWS SES) --------------------------------------------------------
AWS_REGION=us-east-1
SES_FROM_ADDRESS=no-reply@example.org
SES_CONFIGURATION_SET=gpca
