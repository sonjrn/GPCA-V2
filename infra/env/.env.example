# Copy to .env and fill in the blanks. Never commit a populated .env.
#
# Every secret-shaped value here is deliberately EMPTY. An example file that
# ships a working password invites two problems: secret scanners flag it on
# every push, and sooner or later someone copies it straight into production.
# Empty means the app refuses to start until a real value is supplied.
#
# The local dev stack does not need this file at all -- infra/compose supplies
# throwaway defaults for everything below (see the note at the bottom).

# --- Core -------------------------------------------------------------------
FLASK_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173

# Generate each of these with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Minimum 32 characters (RFC 7518 for HS256); startup rejects anything shorter.
SECRET_KEY=
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# --- Database ---------------------------------------------------------------
# Shape: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# Alembic reads DATABASE_URL directly, so migrations run unchanged everywhere.
DATABASE_URL=
DB_CONNECT_TIMEOUT_SECONDS=5

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=gpca

# --- Object storage (MinIO in dev, S3 in prod) ------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET_MEDIA=gpca-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/gpca-media

# --- Stripe -----------------------------------------------------------------
# From the Stripe dashboard. Test-mode values still look like live credentials
# to a scanner, so they do not belong in a tracked file either.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
CHECKOUT_SUCCESS_URL=http://localhost:5173/checkout/success
CHECKOUT_CANCEL_URL=http://localhost:5173/cart

# --- Email (AWS SES) --------------------------------------------------------
AWS_REGION=us-east-1
SES_FROM_ADDRESS=no-reply@example.org
SES_CONFIGURATION_SET=gpca

# ----------------------------------------------------------------------------
# For local development you can skip this file entirely:
#   docker compose -f infra/compose/docker-compose.yml up --build
# The compose file carries throwaway values for the dev stack only. The
# production overlay has no defaults at all -- every secret is `:?required`, so
# a missing one fails the deploy rather than starting half-configured.
